{
  "expo": {
    "name": "Deckhead",
    "slug": "deckhead",
    "scheme": "deckhead",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0A0D",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.deckhead.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Deckhead deck",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.deckhead.deck"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.deckhead.deck",
            "UTTypeDescription": "Deckhead deck",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "deckhead"
              ],
              "public.mime-type": [
                "application/x-deckhead"
              ]
            }
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "android": {
      "package": "com.deckhead.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Deckhead uses the camera to scan deck codes and to take photos for your own cards. Nothing leaves your phone unless you share it.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Deckhead uses motion for the tilt controls: tip the phone down for got it, up to pass. Nothing is recorded."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Deckhead lets you pick photos for your own cards. They stay on your phone, inside your decks.",
          "cameraPermission": "Deckhead uses the camera to scan deck codes and to take photos for your own cards. Nothing leaves your phone unless you share it.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
