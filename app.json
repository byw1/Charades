{
  "expo": {
    "name": "Charades",
    "slug": "charades",
    "scheme": [
      "charades",
      "deckhead"
    ],
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0A0D",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.bywilliaml.charades",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Charades deck",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.charades.deck",
              "com.deckhead.deck"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.charades.deck",
            "UTTypeDescription": "Charades deck",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "charades"
              ],
              "public.mime-type": [
                "application/x-charades"
              ]
            }
          },
          {
            "UTTypeIdentifier": "com.deckhead.deck",
            "UTTypeDescription": "Charades deck (older)",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "deckhead"
              ],
              "public.mime-type": [
                "application/x-deckhead"
              ]
            }
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "android": {
      "package": "com.bywilliaml.charades",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Charades uses the camera to scan deck codes and to take photos for your own cards. Nothing leaves your phone unless you share it.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Charades uses motion for the tilt controls: tip the phone down for got it, up to pass. Nothing is recorded."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Charades lets you pick photos for your own cards. They stay on your phone, inside your decks.",
          "cameraPermission": "Charades uses the camera to scan deck codes and to take photos for your own cards. Nothing leaves your phone unless you share it.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "cf5c109b-e1b3-4baf-98e1-78bcbe31d287"
      }
    },
    "owner": "byw1"
  }
}
